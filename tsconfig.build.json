{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "types": []
  },
  "include": [
    "index.ts",
    "core/**/*.ts",
    "bridge/**/*.ts",
    "wallet/**/*.ts",
    "ui/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "tests", "vite.config.ts", "vitest.config.ts"]
}
